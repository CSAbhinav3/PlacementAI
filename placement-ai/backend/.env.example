# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# Comma-separated list of origins allowed to call this API (local Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Chat history is persisted to Turso (hosted, SQLite-compatible - see
# https://turso.tech, free tier, no card required), not a local file -
# this also runs as a serverless function in production, which has no
# disk to keep a local chat.db on between requests. Create a database in
# the Turso dashboard and paste its values here - use the https:// URL
# scheme (not libsql://) so the client uses HTTP instead of WebSocket.
TURSO_DATABASE_URL=https://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token-here
